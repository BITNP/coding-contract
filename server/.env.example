HOST=127.0.0.1
PORT=3001
JUDGE_URL=http://127.0.0.1:5050
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# DATA_DIR=/var/lib/pioneer

# 如果前端与 API 位于不同站点，需要把下面这行改成 none，然后为 API 配置 HTTPS。
COOKIE_SAME_SITE=lax

# 本地开发可显式开启访客模式，访客共享作战记录和管理台。
# ALLOW_GUEST=1
# 默认要求完整配置以下四项。生产环境始终要求 OIDC。
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
# 示例：OIDC_ISSUER=https://login.bitnp.net/realms/master
# OIDC_CLIENT_ID=coding-contract
# OIDC_REDIRECT_URL=https://oj.bitnp.net/api/auth/callback
# 前端地址，省略时使用回调地址的 origin。
APP_PUBLIC_URL=

# 管理台按当前 OIDC 客户端的 admin role 授权，配置见 docs/keycloak.md。

# 裁判端名单填写 OIDC sub，多个值用逗号分隔；名单外的账号无法进入裁判台。
# 本地访客模式下裁判台直接开放，方便自行联调。
REFEREE_USERS=
