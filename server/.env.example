HOST=127.0.0.1
PORT=3001
JUDGE_URL=http://127.0.0.1:5050
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# DATA_DIR=/var/lib/pioneer

# 如果前端与 API 位于不同站点，需要把下面这行改成 none，然后为 API 配置 HTTPS。
COOKIE_SAME_SITE=lax

# 本地不配置 OIDC 时保留访客模式；生产环境须完整配置以下四项。
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
# 示例：OIDC_ISSUER=https://login.bitnp.net/realms/master
# OIDC_CLIENT_ID=coding-contract
# OIDC_REDIRECT_URL=https://oj.bitnp.net/api/auth/callback
# 前端地址，省略时使用回调地址的 origin。
APP_PUBLIC_URL=
